# environments
.venv/
.venv-authors/

# python caches
__pycache__/
*.pyc
*.pyo

# nauty is built from sources/nauty2_9_3.tar.gz, not committed
build/

# run logs: machine-specific paths and timings, regenerated on every run
results/*.log

# resumable checkpoints of the sweeps
results/n*_partial_*.csv
results/n10_part_*
results/n10_part_*.done

# bulk sweep outputs kept only in compressed form
results/n9_all.csv
results/n10_nonzero.csv

# working copy of the authors' code plus what it produced here
authors_run/

# scratch
sources/probe_*
results/theta_highprec.json
verify.log
results_published/
letter_draft.md
zenodo_steps.md
results/n11_part_*

# n=11 bulk: 10.9 GB raw, 3.3 GB gzipped -- too large for git and for a release
# asset (GitHub caps assets at 2 GB).  The top-1000 and the JSON reports ship; the
# bulk is regenerable by the command documented in the README.
results/n11_nonzero.csv
results/n11_nonzero.csv.gz

# editor
.idea/
results/stage9_degrees_SUPERSEDED_*.jsonl
results/report_9b.txt

# Paper drafts stay out of the repository until they are published; the claim
# checker and its hand-transcribed claim list do not.
papers/*.md

# the downloaded database ships compressed; the decompressed copy is derived
sources/quantum_graphs/quantum10

# Third-party material we may READ but may not REDISTRIBUTE.  SOURCES.md carries the
# link, the access date, the SHA-256 and the quoted lines, which is what Rule 0 needs:
# the quotes prove the source was read; the hash lets anyone reproduce the file.
#   arXiv non-exclusive / assumed licences -- "limits re-use of any type from other
#   entities or individuals" (arXiv's own wording)
sources/nie_ranestad_sturmfels_sdp_degree.*
sources/knuth_sandwich_theorem.*
sources/eprint_1211.5825
sources/ep1211/
sources/letchford_giandomenico_rossi_theta_survey.pdf
sources/letchford_theta_survey.txt
#   the authors' GitHub clone declares no licence; the byte-identical Zenodo archive
#   is CC BY 4.0 and is the copy we keep
sources/quadc5_authors_repo/
#   the quantum-graphs database carries no rights statement; run_db_compare.py fetches it
sources/quantum_graphs/
