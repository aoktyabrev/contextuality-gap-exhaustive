cff-version: 1.2.0
title: "Exact contextuality gaps for graphs up to ten vertices"
message: "If you use this work, please cite it, and cite the paper it continues."
type: software
authors:
  - given-names: Artem
    family-names: Oktyabrev
    email: aoktyabrev@gmail.com
repository-code: "https://github.com/aoktyabrev/contextuality-gap-exhaustive"
license: MIT
